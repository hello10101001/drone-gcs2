# 드론 라즈베리파이 설정 — 고친 뒤: sudo systemctl restart drone-mavproxy drone-bridge drone-camera

# 픽스호크 연결 (TELEM2 ↔ 파이 UART)
SERIAL=/dev/serial0
BAUD=921600

# QGroundControl을 켤 노트북 (비우면 안 보냄). 여러 대면 공백으로: "udp:10.14.61.172:14550 udp:10.14.61.172:14551"
QGC_OUT="udp:10.14.61.172:14550"

# 앱 연결 비밀번호 (앱 설정 → 브리지 비밀번호와 같게)
TOKEN=drone1234

# 사진·임무 정보 폴더
LOCAL=/home/dmdpi/drone-data/local

# 카메라: 0 = 첫 번째 카메라 (CSI 카메라는 libcamerify로 자동 실행)
CAMERA=0
WIDTH=1280
HEIGHT=960

# 열화상 화각 (MLX90640 BAA: 55 35, BAB: 110 75)
HFOV=55
VFOV=35
