# 드론 라즈베리파이 설정 — 고친 뒤: bash install.sh 다시 실행 (또는 sudo systemctl restart drone-mavproxy drone-camera)

# 연결 방식
#   laptop : 드론 ─ 텔레메트리 무선기 ─ 노트북(laptop_bridge.bat) ─ Wi-Fi ─ 태블릿  → 파이는 카메라만 (drone-bridge 꺼짐)
#   wifi   : 태블릿이 파이 Wi-Fi에 바로 연결 (파이의 drone-bridge가 앱과 통신)
MODE=laptop

# 픽스호크 연결 (TELEM2 ↔ 파이 UART)
SERIAL=/dev/serial0
BAUD=921600

# QGroundControl을 켤 노트북으로 파이가 직접 보내기 (비우면 안 보냄). 여러 개면 공백으로: "udp:10.14.61.172:14550 udp:10.14.61.172:14551"
# MODE=laptop 이면 QGC는 노트북 무선기로 보므로 비워 두세요 (두 경로로 받으면 QGC에 기체가 겹쳐 보임)
QGC_OUT=""

# 비밀번호: 앱 설정의 브리지 비밀번호 · 노트북 laptop_bridge.bat의 TOKEN 과 모두 같게
TOKEN=drone1234

# 사진·임무 정보 폴더
LOCAL=/home/dmdpi/drone-data/local

# 카메라: 0 = 첫 번째 카메라 (CSI 카메라는 libcamerify로 자동 실행)
CAMERA=0
WIDTH=1280
HEIGHT=960

# 사진 방향: 사진은 북쪽이 위로 돌려 저장합니다 (지도와 같은 방향, 왕복 비행해도 안 뒤집힘)
# 카메라 장착 각도 = 사진 위쪽이 기체 앞쪽에서 시계 방향으로 몇 도인지. 보통 0.
# 시험 비행 사진이 지도와 다르게 돌아가 있으면 90 / 180 / 270 중 하나로 고치고 sudo systemctl restart drone-camera
CAM_ROT=0
THERM_ROT=0

# 열화상 화각 (MLX90640 BAA: 55 35, BAB: 110 75)
HFOV=55
VFOV=35

# 열화상 탐지 (바꾼 뒤 sudo systemctl restart drone-camera)
#  HOT_DELTA : 주변보다 이만큼(°C) 따뜻하면 사람 후보
#  FIRE_C    : 이 온도(°C) 이상은 불
#  DEDUP_M/S : 이 거리(m)·시간(초) 안에서 다시 보이면 같은 열원으로 합침 (작을수록 잘게 나눔)
HOT_DELTA=3
FIRE_C=45
DEDUP_M=3
DEDUP_S=5
